#!/bin/sh
# Runs the same gate as everything else. Enable with:
#   git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
#
# A commit of documentation alone runs the gate's documentation checks, as CI
# does for such a change (scripts/change-scope.mjs). What is staged is read
# first, while git's variables still name the index being committed.
#
# Git hands a hook the variables that tie git to this repository and index
# (GIT_DIR in a linked worktree, GIT_INDEX_FILE always). Tests that run git in
# their own temporary repositories would inherit them and act on this one, so
# the gate runs without them, as it does by hand and on CI.
scope=$(git diff --cached --name-only --no-renames | node scripts/change-scope.mjs)
unset $(git rev-parse --local-env-vars)
if [ "$scope" = docs ]; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1 -Docs
fi
exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gate.ps1
