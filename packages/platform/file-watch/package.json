{
  "name": "@zhiyin/file-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holds files so that writing, renaming or deleting one waits until it is saved, and reads what changed in a folder from the NTFS change journal.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./thread": "./src/watch-thread.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "koffi": "3.2.1"
  },
  "devDependencies": {
    "@zhiyin/sandbox": "workspace:*",
    "@zhiyin/test-support": "workspace:*"
  }
}
