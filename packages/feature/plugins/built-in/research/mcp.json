{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tavily": {
      "type": "streamable-http",
      "url": "https://mcp.tavily.com/mcp/",
      "name": "Tavily",
      "description": "Searches the web and extracts, maps, and crawls pages for research.",
      "access": "Needs a Tavily API key. Searches count against the Tavily account the key belongs to.",
      "dataDestination": "Searches and requested addresses are sent to mcp.tavily.com.",
      "requestsPerMinute": 100,
      "toolMinutes": { "tavily_research": 16 },
      "toolEffects": [
        {
          "tools": ["tavily_search", "tavily_research"],
          "effects": {
            "reads": "none",
            "changes": "none",
            "sends": "service",
            "actsAsPerson": "none",
            "runs": "none",
            "lasting": false,
            "brings": "outside"
          }
        },
        {
          "tools": ["tavily_extract"],
          "effects": {
            "reads": "none",
            "changes": "none",
            "sends": "chosen",
            "carries": "address",
            "actsAsPerson": "none",
            "runs": "none",
            "lasting": false,
            "brings": "outside"
          },
          "destination": "{urls}"
        },
        {
          "tools": ["tavily_crawl", "tavily_map"],
          "effects": {
            "reads": "none",
            "changes": "none",
            "sends": "chosen",
            "carries": "address",
            "actsAsPerson": "none",
            "runs": "none",
            "lasting": false,
            "brings": "outside"
          },
          "destination": "{url}"
        }
      ],
      "setup": {
        "url": "https://app.tavily.com/home",
        "keyName": "API key",
        "advice": "Sign in, then copy your API key from the dashboard."
      }
    }
  }
}
